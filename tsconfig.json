{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "void/env"
    ]
  },
  "include": [
    "auth.ts",
    "env.ts",
    "vite.config.ts",
    "void.config.ts",
    "cloudflare.config.ts",
    "server",
    "shared",
    "client",
    "pages",
    "routes",
    "db",
    "workers"
  ]
}
